          "    pm.environment.set(\"baseUrl\", \"https://dummyjson.com\");\r",
          "}\r",
          "\r",
          "if (!pm.environment.get(\"random\")) {\r",
          "    pm.environment.set(\"random\", Math.floor(Math.random() * 100000));\r",
          "}"
        ]
      }
    },
