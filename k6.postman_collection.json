    {
      "name": "Search Products Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Search results contain products\", function () {\r",
              "    pm.expect(jsonData.products.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Each product has id and title\", function () {\r",
              "    jsonData.products.forEach((product) => {\r",
              "        pm.expect(product).to.have.property(\"id\");\r",
              "        pm.expect(product).to.have.property(\"title\");\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?q=phone",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "phone"
            }
          ]
        }
      },
      "response": []
    }
